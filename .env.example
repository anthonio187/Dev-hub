# Copy to .env locally, or set these in your host's dashboard. Never commit real values.

# Required in production. Neon: copy the connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Required in production (app refuses to start without it when PRODUCTION=1).
SECRET_KEY=replace-with-output-of-python-secrets-token_hex-32
PRODUCTION=1

# Optional: a GitHub token with NO scopes (public read only). Raises the GitHub API
# limit from 60 to 5,000 requests/hour for profile and repo lookups.
GITHUB_TOKEN=

# Optional
LOG_LEVEL=INFO

# Optional: object storage for uploads (Cloudflare R2, AWS S3, Supabase Storage).
# Without S3_BUCKET, files are stored in the database (fine for small deployments).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Optional: email for password reset (Brevo SMTP relay: smtp-relay.brevo.com, port 587).
# Without SMTP_HOST, dev mode prints reset emails to the console; production logs an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DevX <no-reply@yourdomain.dev>

# Public URL used in password-reset links (e.g. https://devx.example.com).
APP_URL=
